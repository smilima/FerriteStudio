// The Form Designer canvas: a form window with real Slint widgets on it,
// covered by an input layer so they can be selected, moved and resized
// instead of reacting to clicks.

import {
    Button, CheckBox, ComboBox, LineEdit, Palette, ProgressIndicator, ScrollView, Slider, SpinBox,
    Switch, TextEdit,
} from "std-widgets.slint";
import { ControlItem } from "types.slint";

// Draws one control exactly as the running app will.
component ControlView inherits Rectangle {
    in property <ControlItem> c;

    if c.kind == "Button": Button {
        width: parent.width;
        height: parent.height;
        text: c.text;
        enabled: c.enabled;
        primary: c.primary;
        checkable: c.checkable;
    }
    if c.kind == "Text": Text {
        width: parent.width;
        height: parent.height;
        text: c.text;
        font-size: c.font-size;
        font-weight: c.font-weight;
        color: c.has-fg ? c.fg : Palette.foreground;
    }
    if c.kind == "LineEdit": LineEdit {
        width: parent.width;
        height: parent.height;
        text: c.text;
        placeholder-text: c.placeholder;
        enabled: c.enabled;
        read-only: c.read-only;
    }
    if c.kind == "TextEdit": TextEdit {
        width: parent.width;
        height: parent.height;
        text: c.text;
        placeholder-text: c.placeholder;
        enabled: c.enabled;
        read-only: c.read-only;
    }
    if c.kind == "CheckBox": CheckBox {
        width: parent.width;
        height: parent.height;
        text: c.text;
        checked: c.checked;
        enabled: c.enabled;
    }
    if c.kind == "Switch": Switch {
        width: parent.width;
        height: parent.height;
        text: c.text;
        checked: c.checked;
        enabled: c.enabled;
    }
    if c.kind == "ComboBox": ComboBox {
        width: parent.width;
        height: parent.height;
        model: c.items;
        current-index: c.current-index;
        enabled: c.enabled;
    }
    if c.kind == "SpinBox": SpinBox {
        width: parent.width;
        height: parent.height;
        value: c.ivalue;
        minimum: c.imin;
        maximum: c.imax;
        enabled: c.enabled;
    }
    if c.kind == "Slider": Slider {
        width: parent.width;
        height: parent.height;
        value: c.fvalue;
        minimum: c.fmin;
        maximum: c.fmax;
        enabled: c.enabled;
    }
    if c.kind == "ProgressIndicator": ProgressIndicator {
        width: parent.width;
        height: parent.height;
        progress: c.progress;
        indeterminate: c.indeterminate;
    }
    if c.kind == "Rectangle": Rectangle {
        width: parent.width;
        height: parent.height;
        background: c.has-background ? c.background : transparent;
        border-radius: c.border-radius;
        border-width: c.border-width;
        border-color: c.border-color;
    }
}

export component Designer inherits Rectangle {
    in property <[ControlItem]> controls;
    in property <int> selected: -1;
    in property <string> form-title;
    in property <int> form-width: 480;
    in property <int> form-height: 320;
    in property <string> active-tool;

    callback select(int);
    callback drop-control(int, int);
    callback drag-control(int, int, int);
    callback resize-control(int, int, int);
    callback resize-form(int, int);
    callback control-double-clicked(int);
    callback delete-selected();
    callback nudge(int, int);
    callback key(KeyEvent) -> bool;

    property <length> form-dw;
    property <length> form-dh;
    property <color> accent: #2f6fd6;

    background: Palette.alternate-background;

    public function focus-canvas() {
        fs.focus();
    }

    fs := FocusScope {
        key-pressed(e) => {
            if e.text == Key.Delete {
                root.delete-selected();
                return accept;
            }
            if e.text == Key.LeftArrow && e.modifiers.control { root.nudge(-1, 0); return accept; }
            if e.text == Key.RightArrow && e.modifiers.control { root.nudge(1, 0); return accept; }
            if e.text == Key.UpArrow && e.modifiers.control { root.nudge(0, -1); return accept; }
            if e.text == Key.DownArrow && e.modifiers.control { root.nudge(0, 1); return accept; }
            if root.key(e) { return accept; }
            reject
        }

        ScrollView {
            content-width: max(self.width, root.form-width * 1px + root.form-dw + 96px);
            content-height: max(self.height, root.form-height * 1px + root.form-dh + 120px);

            // The form window: caption bar plus client area.
            frame := Rectangle {
                x: 32px;
                y: 32px;
                width: root.form-width * 1px + root.form-dw + 2px;
                height: root.form-height * 1px + root.form-dh + 30px;
                background: Palette.background;
                border-width: 1px;
                border-color: root.selected == -1 ? root.accent : #8a94a0;
                drop-shadow-blur: 10px;
                drop-shadow-color: #00000040;

                Rectangle {
                    x: 1px;
                    y: 1px;
                    width: parent.width - 2px;
                    height: 28px;
                    background: root.selected == -1 ? root.accent : #5d6b7a;
                    Text {
                        x: 10px;
                        height: parent.height;
                        vertical-alignment: center;
                        text: root.form-title;
                        color: white;
                        font-weight: 600;
                    }
                }

                client := Rectangle {
                    x: 1px;
                    y: 29px;
                    width: root.form-width * 1px + root.form-dw;
                    height: root.form-height * 1px + root.form-dh;
                    clip: true;

                    // Designer grid, every 16 px.
                    for row in floor(root.form-height / 16) + 1: Rectangle {
                        y: row * 16px;
                        height: 1px;
                        for col in floor(root.form-width / 16) + 1: Rectangle {
                            x: col * 16px;
                            width: 1px;
                            height: 1px;
                            background: #00000030;
                        }
                    }

                    TouchArea {
                        mouse-cursor: root.active-tool != "" ? MouseCursor.crosshair : MouseCursor.default;
                        pointer-event(e) => {
                            if e.kind == PointerEventKind.down && e.button == PointerEventButton.left {
                                fs.focus();
                                if root.active-tool != "" {
                                    root.drop-control(self.mouse-x / 1px, self.mouse-y / 1px);
                                } else {
                                    root.select(-1);
                                }
                            }
                        }
                    }

                    for c[i] in root.controls: cell := Rectangle {
                        property <length> dx;
                        property <length> dy;
                        property <length> dw;
                        property <length> dh;
                        x: c.x * 1px + self.dx;
                        y: c.y * 1px + self.dy;
                        width: max(8px, c.w * 1px + self.dw);
                        height: max(8px, c.h * 1px + self.dh);

                        ControlView {
                            c: c;
                            width: parent.width;
                            height: parent.height;
                        }

                        // Input layer: select, drag to move, double-click for the default event.
                        TouchArea {
                            mouse-cursor: root.active-tool != "" ? MouseCursor.crosshair : MouseCursor.move;
                            pointer-event(e) => {
                                if e.kind == PointerEventKind.down && e.button == PointerEventButton.left {
                                    fs.focus();
                                    if root.active-tool != "" {
                                        root.drop-control((cell.x + self.mouse-x) / 1px, (cell.y + self.mouse-y) / 1px);
                                    } else {
                                        root.select(i);
                                    }
                                }
                                if e.kind == PointerEventKind.up && e.button == PointerEventButton.left {
                                    if cell.dx != 0px || cell.dy != 0px {
                                        root.drag-control(i, cell.dx / 1px, cell.dy / 1px);
                                        cell.dx = 0px;
                                        cell.dy = 0px;
                                    }
                                }
                            }
                            moved => {
                                if self.pressed && root.active-tool == "" {
                                    cell.dx += self.mouse-x - self.pressed-x;
                                    cell.dy += self.mouse-y - self.pressed-y;
                                }
                            }
                            double-clicked => {
                                root.control-double-clicked(i);
                            }
                        }

                        if root.selected == i: Rectangle {
                            border-width: 1px;
                            border-color: root.accent;
                        }
                        if root.selected == i: Rectangle {
                            x: parent.width - 8px;
                            y: parent.height - 8px;
                            width: 8px;
                            height: 8px;
                            background: root.accent;
                            border-width: 1px;
                            border-color: white;
                            TouchArea {
                                mouse-cursor: MouseCursor.nwse-resize;
                                moved => {
                                    if self.pressed {
                                        cell.dw += self.mouse-x - self.pressed-x;
                                        cell.dh += self.mouse-y - self.pressed-y;
                                    }
                                }
                                pointer-event(e) => {
                                    if e.kind == PointerEventKind.up && (cell.dw != 0px || cell.dh != 0px) {
                                        root.resize-control(i, cell.dw / 1px, cell.dh / 1px);
                                        cell.dw = 0px;
                                        cell.dh = 0px;
                                    }
                                }
                            }
                        }
                    }
                }

                // Form resize handle.
                Rectangle {
                    x: parent.width - 10px;
                    y: parent.height - 10px;
                    width: 10px;
                    height: 10px;
                    background: root.selected == -1 ? root.accent : #8a94a0;
                    TouchArea {
                        mouse-cursor: MouseCursor.nwse-resize;
                        moved => {
                            if self.pressed {
                                root.form-dw += self.mouse-x - self.pressed-x;
                                root.form-dh += self.mouse-y - self.pressed-y;
                            }
                        }
                        pointer-event(e) => {
                            if e.kind == PointerEventKind.up && (root.form-dw != 0px || root.form-dh != 0px) {
                                root.resize-form(root.form-dw / 1px, root.form-dh / 1px);
                                root.form-dw = 0px;
                                root.form-dh = 0px;
                            }
                        }
                    }
                }
            }
        }
    }
}
